# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Codeplain (spec-driven codegen; M1) ---
CODEPLAIN_API_KEY=
CODEPLAIN_API=https://api.codeplain.ai

# --- FLock (LLM inference; M2) ---
FLOCK_API_KEY=
FLOCK_BASE_URL=https://api.flock.io/v1

# --- Solvimon (metered billing sandbox; M5) ---
SOLVIMON_API_KEY=
SOLVIMON_BASE_URL=https://test.api.solvimon.com/v1

# --- Walrus (attestation; M4) — public testnet, no key needed for HTTP path ---
WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space

# --- DeepBook (realistic base; read-only, no key) ---
DEEPBOOK_INDEXER_URL=https://deepbook-indexer.mainnet.mystenlabs.com

# --- Sui object anchor (STRETCH only) ---
SUI_SECRET_KEY=
SUI_NETWORK=testnet
